# Template for android/keystore.properties — copy, don't edit this file.
#
#   cp keystore.properties.example android/keystore.properties
#
# The real file is gitignored and must never be committed. It holds the
# passwords to your Play Store upload key; losing control of it means someone
# else can publish updates as you.
#
# Generate the keystore first:
#   keytool -genkey -v -keystore pitwall-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias pitwall

# Absolute path to the .jks file. Keep the keystore OUTSIDE this repo.
storeFile=/Users/you/keys/pitwall-upload.jks

# The keystore password (the first one keytool asked for).
storePassword=CHANGEME

# The -alias value you passed to keytool.
keyAlias=pitwall

# The key password. If you pressed Enter to reuse the store password,
# set this to the same value as storePassword.
keyPassword=CHANGEME
