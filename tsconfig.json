{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@engine/*": ["./src/engine/*"],
      "@data/*": ["./src/data/*"],
      "@state/*": ["./src/state/*"],
      "@canvas/*": ["./src/canvas/*"],
      "@ui/*": ["./src/ui/*"],
      "@audio/*": ["./src/audio/*"],
      "@hooks/*": ["./src/hooks/*"]
    }
  },
  "include": ["src", "tests"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
